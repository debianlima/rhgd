{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgh.local/contracts/rhgd-hagger-code-context/1",
  "title": "RHGD Hagger Code Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code_context_ref", "query", "provenance", "result", "authority"],
  "properties": {
    "schema_version": {"const": "rhgd-hagger-code-context/1"},
    "code_context_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_ref", "commit_sha", "provider", "alias", "provider_version", "provider_commit", "index_ref", "manifest_sha256", "source_authority", "mutable_tools", "operations", "required_symbols"],
      "properties": {
        "repo_ref": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "provider": {"const": "code-graph-rag"},
        "alias": {"const": "hagger"},
        "provider_version": {"type": "string", "minLength": 1},
        "provider_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "index_ref": {"type": "string", "pattern": "^file://"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_authority": {"const": "git"},
        "mutable_tools": {"const": "disabled"},
        "operations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["summary", "resolve", "definition", "callers", "callees", "importers", "implementors", "overrides", "tests-reaching"]}
        },
        "required_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "query": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "properties": {
        "operation": {"enum": ["summary", "resolve", "definition", "callers", "callees", "importers", "implementors", "overrides", "tests-reaching"]},
        "symbol": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["repo_ref", "source_commit", "provider", "provider_version", "provider_commit", "manifest_sha256", "source_dirty"],
      "properties": {
        "repo_ref": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "provider": {"const": "code-graph-rag"},
        "provider_version": {"type": "string", "minLength": 1},
        "provider_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_dirty": {"const": false}
      }
    },
    "result": {},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["effect", "scheduler", "lease_grant", "assignment", "admission", "source_authority", "mutable_tools"],
      "properties": {
        "effect": {"const": "NONE"},
        "scheduler": {"const": false},
        "lease_grant": {"const": false},
        "assignment": {"const": false},
        "admission": {"const": false},
        "source_authority": {"const": "git"},
        "mutable_tools": {"const": "disabled"}
      }
    }
  }
}
